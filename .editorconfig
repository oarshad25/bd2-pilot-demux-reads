# See http://editorconfig.org
root = true

[*]
charset = utf8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
indent_style = space

[*.{py,smk,r,R}]
max_line_length = 100

[*.{y{a,}ml,html,css,scss,js}]
indent_size = 2

[*.{md,Rmd,rst}]
trim_trailing_whitespace = false
indent_size = 2